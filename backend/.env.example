# ─────────────────────────────────────────────────────────────────────────────
# ITIL Service Desk — Backend Environment Variables
# Copy this file:  cp .env.example .env
# Then fill in every value below before running the server.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/itil_servicedesk
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/itil_servicedesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/itil_servicedesk

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# ── Email (optional — notifications are skipped if not set) ──────────────────
# Use an SMTP app password, not your main account password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-smtp-app-password

# ── Anthropic Claude API (optional — AI suggestions feature) ─────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
